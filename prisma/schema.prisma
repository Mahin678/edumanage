generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Programme {
  id         String   @id @default(cuid())
  name       String   @unique
  code       String   @unique
  feeAmount  Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  users User[]
}

model User {
  id           String   @id @default(cuid())
  studentId    String   @unique
  name         String
  email        String   @unique
  dateOfBirth  DateTime?

  programmeId  String?
  programme    Programme? @relation(fields: [programmeId], references: [id])

  academicYear String?
  status       String?  @default("ACTIVE")

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  totalFee     Float?
  halfFee      Float?
  fullFee      Float?
  adjustedFee  Float?

  halfDueDate     DateTime?
  halfPaidDate    DateTime?
  halfReferenceNo String?

  fullDueDate     DateTime?
  fullPaidDate    DateTime?
  fullReferenceNo String?

  // relations
  submissions Submission[]
  grades      Grade[]
}

model Payment {
  id              String    @id @default(cuid())
  studentId       String    @unique
  studentName     String
  email           String?
  programmeId     String?

  halfDueDate     DateTime?
  halfPaidDate    DateTime?
  halfReferenceNo String?

  fullDueDate     DateTime?
  fullPaidDate    DateTime?
  fullReferenceNo String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Assessment {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  deadline    DateTime

  createdDate DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  submissions Submission[]
  grades      Grade[]

  @@map("assessments")
}

model Submission {
  id              String   @id @default(cuid())
  userId          String
  assessmentId    Int

  fileUrl         String
  fileName        String
  submittedAt     DateTime

  isLate          Boolean  @default(false)
  status          String   @default("Pending")
  submissionCount Int      @default(1)

  // 🔥 CASCADE FIX
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  grade Grade?

  @@unique([userId, assessmentId])
}

model Grade {
  id             String   @id @default(cuid())
  userId         String
  assessmentId   Int
  submissionId   String   @unique

  score          Int
  classification String
  isPublished    Boolean  @default(false)
  gradedBy       String
  gradedAt       DateTime @default(now())

  // 🔥 CASCADE FIX
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([userId, assessmentId])
  @@map("grades")
}

enum SubmissionStatus {
  Pending
  Passed
  Failed
}