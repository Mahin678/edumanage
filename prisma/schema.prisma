// prisma/schema.prisma — complete file, replace yours entirely

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Programme {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  feeAmount Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String   @id @default(cuid())
  studentId    String   @unique          // human-readable e.g. "STU-001"
  name         String
  email        String   @unique
  dateOfBirth  DateTime?
  programmeId  String?
  academicYear String?
  status       String?  @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Fee fields
  totalFee    Float?
  halfFee     Float?
  fullFee     Float?
  adjustedFee Float?

  // Payment fields
  halfDueDate     DateTime?
  halfPaidDate    DateTime?
  halfReferenceNo String?
  fullDueDate     DateTime?
  fullPaidDate    DateTime?
  fullReferenceNo String?

  // Relations
  submissions Submission[]   // back-relation required by Prisma
}

model Payment {
  id              String    @id @default(cuid())
  studentId       String    @unique
  studentName     String
  email           String?
  programmeId     String?
  halfDueDate     DateTime?
  halfPaidDate    DateTime?
  halfReferenceNo String?
  fullDueDate     DateTime?
  fullPaidDate    DateTime?
  fullReferenceNo String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Assessment {
  id          Int          @id @default(autoincrement())
  name        String
  description String
  createdDate DateTime     @default(now())
  deadline    DateTime
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  submissions Submission[]

  @@map("assessments")
}

model Submission {
  id              String   @id @default(cuid())
  userId          String
  assessmentId    Int
  fileUrl         String
  fileName        String
  submittedAt     DateTime
  isLate          Boolean  @default(false)
  status          String   @default("Pending")
  submissionCount Int      @default(1)   // ← এই line টা যোগ করো

  user       User       @relation(fields: [userId], references: [id])
  assessment Assessment @relation(fields: [assessmentId], references: [id])

  @@unique([userId, assessmentId])
}

enum SubmissionStatus {
  Pending
  Passed
  Failed
}
