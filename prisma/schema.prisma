// prisma/schema.prisma — complete file

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Programme {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  feeAmount Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String   @id @default(cuid())
  studentId    String   @unique          // human-readable e.g. "STU-001"
  name         String
  email        String   @unique
  dateOfBirth  DateTime?
  programmeId  String?
  academicYear String?
  status       String?  @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Fee fields
  totalFee    Float?
  halfFee     Float?
  fullFee     Float?
  adjustedFee Float?

  // Payment fields
  halfDueDate     DateTime?
  halfPaidDate    DateTime?
  halfReferenceNo String?
  fullDueDate     DateTime?
  fullPaidDate    DateTime?
  fullReferenceNo String?

  // Relations
  submissions Submission[]   // back-relation required by Prisma
  grades      Grade[]        // ← ADDED: Relation to grades
}

model Payment {
  id              String    @id @default(cuid())
  studentId       String    @unique
  studentName     String
  email           String?
  programmeId     String?
  halfDueDate     DateTime?
  halfPaidDate    DateTime?
  halfReferenceNo String?
  fullDueDate     DateTime?
  fullPaidDate    DateTime?
  fullReferenceNo String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Assessment {
  id          Int          @id @default(autoincrement())
  name        String
  description String
  createdDate DateTime     @default(now())
  deadline    DateTime
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  submissions Submission[]
  grades      Grade[]      // ← ADDED: Relation to grades

  @@map("assessments")
}

model Submission {
  id              String   @id @default(cuid())
  userId          String
  assessmentId    Int
  fileUrl         String
  fileName        String
  submittedAt     DateTime
  isLate          Boolean  @default(false)
  status          String   @default("Pending")
  submissionCount Int      @default(1)

  user       User       @relation(fields: [userId], references: [id])
  assessment Assessment @relation(fields: [assessmentId], references: [id])
  
  grade      Grade?     // ← ADDED: One-to-one relation with Grade

  @@unique([userId, assessmentId])
}

// ← ADDED: New Grade model
model Grade {
  id             String   @id @default(cuid())
  userId         String
  assessmentId   Int
  submissionId   String   @unique   // One grade per submission
  score          Int                // 0-100
  classification String             // "Fail" | "Pass" | "Merit" | "Distinction"
  isPublished    Boolean  @default(false)  // Staff controls visibility
  gradedBy       String             // Staff ID who graded
  gradedAt       DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  user       User       @relation(fields: [userId], references: [id])
  assessment Assessment @relation(fields: [assessmentId], references: [id])
  submission Submission @relation(fields: [submissionId], references: [id])

  @@unique([userId, assessmentId])  // One grade per student per assessment
  @@map("grades")
}

// Keep existing enum (may not be needed if using String for status)
enum SubmissionStatus {
  Pending
  Passed
  Failed
}